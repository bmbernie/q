[Unit]
Description=q terminal query daemon
After=network-online.target chatgpt-worker-broker.service
Wants=network-online.target
Requires=chatgpt-worker-broker.service

[Service]
Type=simple
WorkingDirectory=@Q_ROOT@

Environment=Q_BROKER_URL=http://127.0.0.1:8792

ExecStart=@Q_ROOT@/.venv/bin/qd serve

Restart=on-failure
RestartSec=2
TimeoutStopSec=30
UMask=0077

[Install]
WantedBy=default.target
